{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pletina",
  "version": "../package.json",
  "identifier": "dev.musify.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Pletina",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0f0f10",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; img-src 'self' data: https: http: asset: http://asset.localhost; media-src https: http: asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "devCsp": "default-src 'self'; script-src 'self' blob:; img-src 'self' data: https: http: asset: http://asset.localhost; media-src https: http: asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "category": "Music",
    "publisher": "Pletina",
    "homepage": "https://github.com/diad87/pletina",
    "copyright": "© 2026 diad87 · GPL-3.0-or-later",
    "shortDescription": "Reproductor de música personal",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzMDQ1MTA4RDJFRjczRUUKUldUdWMrL1NDRkVFRTQ5N1JmL3hWd3JxL1VHNUpqeHljdWI0cWkrY0I4TGxqZS9ZOHljUlpkRWcK",
      "endpoints": [
        "https://github.com/diad87/pletina-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
