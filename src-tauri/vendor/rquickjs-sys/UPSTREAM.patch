+            } else {
+                "/DWIN32_LEAN_AND_MEAN /std:c11 /experimental:c11atomics"
+            };
+            env::set_var("CFLAGS", cflags);
+            configure_windows_clang(&mut builder, out_dir);
         } else {
             env::set_var("CFLAGS", "-DWIN32_LEAN_AND_MEAN -std=c11");
         }
