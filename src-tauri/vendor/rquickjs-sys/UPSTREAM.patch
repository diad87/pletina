+// Pletina's optional Windows toolchain is local to this cc::Build. Do not set
+// CC/AR globally: that would also change SQLite and unrelated native crates.
+fn configure_windows_clang(builder: &mut cc::Build, out_dir: &Path) {
+    let Some(requested) = env::var_os("MUSIFY_QUICKJS_CLANG_CL") else {
+        return;
+    };
+    // Unlike cc's internal discovery, this public registry helper does not
+    // register the SDK environment with Cargo on our behalf.
+    for name in [
+        "INCLUDE",
+        "LIB",
+        "LIBPATH",
+        "VCINSTALLDIR",
+        "VSINSTALLDIR",
+        "VCToolsVersion",
+        "VisualStudioVersion",
+        "WindowsSdkDir",
+        "WindowsSDKVersion",
+        "VSCMD_ARG_TGT_ARCH",
+        "VSCMD_ARG_VCVARS_SPECTRE",
+        "VSTEL_MSBuildProjectFullPath",
+    ] {
+        println!("cargo:rerun-if-env-changed={name}");
+    }
+    let compiler = PathBuf::from(requested);
+    assert!(
+        compiler.is_absolute() && compiler.is_file(),
+        "MUSIFY_QUICKJS_CLANG_CL must name an existing absolute clang-cl path"
+    );
+    assert!(
+        compiler
+            .file_name()
+            .and_then(|name| name.to_str())
+            .is_some_and(|name| name.eq_ignore_ascii_case("clang-cl.exe")),
+        "MUSIFY_QUICKJS_CLANG_CL must select clang-cl.exe (Windows MSVC ABI)"
+    );
+    let archiver = compiler.parent().unwrap().join("llvm-lib.exe");
+    assert!(
+        archiver.is_file(),
+        "llvm-lib.exe must accompany clang-cl.exe"
+    );
+    let version = process::Command::new(&compiler)
+        .arg("--version")
+        .output()
+        .expect("Unable to inspect the selected clang-cl compiler");
+    assert!(version.status.success(), "clang-cl --version failed");
+    let version = String::from_utf8(version.stdout).expect("Non-UTF-8 compiler version");
+    assert!(
+        version.contains("clang version"),
+        "Expected a Clang compiler"
+    );
+
+    let target = env::var("TARGET").expect("No TARGET provided by Cargo");
+    let msvc = cc::windows_registry::find_tool(&target, "cl.exe")
+        .expect("The selected clang-cl requires installed Visual Studio C++ tools and Windows SDK");
+    // Explicit .compiler() bypasses cc's normal clang-cl environment discovery.
+    // Carry the discovered SDK/CRT environment into this builder's child tools.
+    for (key, value) in msvc.env() {
+        builder.env(key, value);
+    }
+    builder.compiler(&compiler).archiver(&archiver);
+
+    // Android's bundled clang-cl targets Windows, but its resource stdatomic.h
+    // assumes Bionic. Give a byte-identical installed MSVC header precedence.
+    // A distinct OUT_DIR path is required: clang deduplicates the VC include
+    // directory against INCLUDE and otherwise puts its resource header first.
+    if version.starts_with("Android (") {
+        let includes = msvc
+            .env()
+            .iter()
+            .find(|(key, _)| key.to_string_lossy().eq_ignore_ascii_case("INCLUDE"))
+            .map(|(_, value)| value.clone())
+            .or_else(|| env::var_os("INCLUDE"))
+            .expect("Visual Studio's INCLUDE directories are unavailable");
+        let atomics = env::split_paths(&includes)
+            .map(|directory| directory.join("stdatomic.h"))
+            .find(|path| path.is_file())
+            .expect("The NDK clang-cl needs Visual Studio's installed stdatomic.h");
+        let headers = out_dir.join("musify-windows-headers");
+        fs::create_dir_all(&headers).expect("Cannot create the private header directory");
+        fs::copy(&atomics, headers.join("stdatomic.h"))
+            .expect("Cannot copy the installed Windows atomics header");
+        builder.include(headers);
+        println!("cargo:rerun-if-changed={}", atomics.display());
+        println!("cargo:warning=QuickJS atomics: installed Visual Studio header (OUT_DIR copy)");
+    }
+    println!("cargo:rerun-if-changed={}", compiler.display());
+    println!("cargo:rerun-if-changed={}", archiver.display());
+    println!(
+        "cargo:warning=QuickJS Windows compiler: {} | {} | computed-goto dispatch; upstream rquickjs-sys 0.14.0",
+        compiler.display(),
+        version.lines().next().unwrap_or("unknown version")
+    );
+}
+
