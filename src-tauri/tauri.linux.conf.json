{
  "build": {
    "beforeDevCommand": "node scripts/prepare-linux-runtime.mjs && npm run dev",
    "beforeBuildCommand": "node scripts/prepare-linux-runtime.mjs && npm run build"
  },
  "bundle": {
    "resources": {
      "runtime/node": "bin/node",
      "runtime/LICENSE-node": "licenses/node.txt"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      }
    }
  }
}
